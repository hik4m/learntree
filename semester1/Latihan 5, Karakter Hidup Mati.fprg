    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="huruf" type="String" array="False" size=""/>
            <output expression="&quot;Input Huruf&quot;" newline="True"/>
            <input variable="huruf"/>
            <if expression="huruf=&quot;a&quot; Or huruf=&quot;A&quot; Or huruf=&quot;i&quot; Or huruf=&quot;I&quot; Or huruf=&quot;U&quot; Or huruf=&quot;u&quot; Or huruf=&quot;e&quot; Or huruf=&quot;E&quot; Or huruf=&quot;o&quot; Or huruf=&quot;O&quot;">
                <then>
                    <output expression="&quot;HURUF HIDUP&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;HURUF MATI&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
