<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="TUGAS 2, Menghitung Bangun Datar"/>
        <attribute name="authors" value="gakyy"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2025-09-25 09.55.46 PM"/>
        <attribute name="created" value="Z2FreXk7QU5HR0FDVVk7MjAyNS0wOS0yNTswMzo1ODo1MiBQTTsyNDMy"/>
        <attribute name="edited" value="Z2FreXk7QU5HR0FDVVk7MjAyNS0wOS0yNTswNDoxOTo1MyBQTTsxOzI1Mzk="/>
        <attribute name="edited" value="SFA7REVTS1RPUC1MQjYwUUc5OzIwMjUtMDktMjU7MDkuNTUuNDYgUE07MzsyNTcy"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="Pilihan, Pilihan2, hasil" type="Integer" array="False" size=""/>
            <declare name="Pilihan3, identifikasi" type="String" array="False" size=""/>
            <output expression="&quot;Mau Menghitung Apa?&quot; &amp;ToChar(13)&amp; &quot;1. Jajar Genjang&quot; &amp;ToChar(13)&amp; &quot;2. Belah Ketupat&quot; &amp;ToChar(13)&amp; &quot;3. Trapesium&quot; &amp;ToChar(13)&amp; &quot;4. Layang-layang&quot;" newline="True"/>
            <input variable="Pilihan"/>
            <if expression="Pilihan=1">
                <then>
                    <assign variable="Pilihan3" expression="&quot;Jajar Genjang&quot;"/>
                    <declare name="s1, s2, a, t" type="Integer" array="False" size=""/>
                    <output expression="&quot;Hitung Luas(1) / Keliling(terserah)?&quot;" newline="True"/>
                    <input variable="Pilihan2"/>
                    <if expression="Pilihan2=1">
                        <then>
                            <assign variable="identifikasi" expression="&quot;Luas&quot;"/>
                            <output expression="&quot;Input Alas&quot;" newline="True"/>
                            <input variable="a"/>
                            <output expression="&quot;Input Tinggi&quot;" newline="True"/>
                            <input variable="t"/>
                            <assign variable="hasil" expression="a*t"/>
                        </then>
                        <else>
                            <assign variable="identifikasi" expression="&quot;Keliling&quot;"/>
                            <output expression="&quot;Input Sisi Pertama&quot;" newline="True"/>
                            <input variable="s1"/>
                            <output expression="&quot;Input Sisi Kedua&quot;" newline="True"/>
                            <input variable="s2"/>
                            <assign variable="hasil" expression="2*(s1+s2)"/>
                        </else>
                    </if>
                </then>
                <else>
                    <if expression="Pilihan=2">
                        <then>
                            <assign variable="Pilihan3" expression="&quot;Belah Ketupat&quot;"/>
                            <declare name="d1, d2, sisi" type="Integer" array="False" size=""/>
                            <output expression="&quot;Hitung Luas(1) / Keliling(2)?&quot;" newline="True"/>
                            <input variable="Pilihan2"/>
                            <if expression="Pilihan2=1">
                                <then>
                                    <assign variable="identifikasi" expression="&quot;Luas&quot;"/>
                                    <output expression="&quot;Input Diagonal 1&quot;" newline="True"/>
                                    <input variable="d1"/>
                                    <output expression="&quot;Input Tinggi&quot;" newline="True"/>
                                    <input variable="d2"/>
                                    <assign variable="hasil" expression="0.5/(d1*d2)"/>
                                </then>
                                <else>
                                    <assign variable="identifikasi" expression="&quot;Keliling&quot;"/>
                                    <output expression="&quot;Input Sisi Pertama&quot;" newline="True"/>
                                    <input variable="s1"/>
                                    <assign variable="hasil" expression="4*sisi"/>
                                </else>
                            </if>
                        </then>
                        <else>
                            <if expression="Pilihan=3">
                                <then>
                                    <assign variable="Pilihan3" expression="&quot;Trapesium&quot;"/>
                                    <declare name="a, b, c, t, d" type="Integer" array="False" size=""/>
                                    <output expression="&quot;Hitung Luas(1) / Keliling(2)?&quot;" newline="True"/>
                                    <input variable="Pilihan2"/>
                                    <if expression="Pilihan2=1">
                                        <then>
                                            <assign variable="identifikasi" expression="&quot;Luas&quot;"/>
                                            <output expression="&quot;Input Sisi Sejajar 1&quot;" newline="True"/>
                                            <input variable="a"/>
                                            <output expression="&quot;Input Sisi Sejajar 2&quot;" newline="True"/>
                                            <input variable="b"/>
                                            <output expression="&quot;Input Tinggi&quot;" newline="True"/>
                                            <input variable="t"/>
                                            <assign variable="hasil" expression="0.5 * (a+b) *t"/>
                                        </then>
                                        <else>
                                            <assign variable="identifikasi" expression="&quot;Keliling&quot;"/>
                                            <output expression="&quot;Input Sisi Pertama&quot;" newline="True"/>
                                            <input variable="a"/>
                                            <output expression="&quot;Input Sisi Kedua&quot;" newline="True"/>
                                            <input variable="b"/>
                                            <output expression="&quot;Input Sisi Ketiga&quot;" newline="True"/>
                                            <input variable="c"/>
                                            <output expression="&quot;Input Sisi Keempat&quot;" newline="True"/>
                                            <input variable="d"/>
                                            <assign variable="hasil" expression="a+b+c+d"/>
                                        </else>
                                    </if>
                                </then>
                                <else>
                                    <if expression="Pilihan=4">
                                        <then>
                                            <assign variable="Pilihan3" expression="&quot;Layang-layang&quot;"/>
                                            <declare name="d1, d2, a, b" type="Integer" array="False" size=""/>
                                            <output expression="&quot;Hitung Luas(1) / Keliling(2)?&quot;" newline="True"/>
                                            <input variable="Pilihan2"/>
                                            <if expression="Pilihan2=1">
                                                <then>
                                                    <assign variable="identifikasi" expression="&quot;Luas&quot;"/>
                                                    <output expression="&quot;Input Diagonal 1&quot;" newline="True"/>
                                                    <input variable="d1"/>
                                                    <output expression="&quot;Input Diagonal 2&quot;" newline="True"/>
                                                    <input variable="d2"/>
                                                    <assign variable="hasil" expression="0.5*d1*d2"/>
                                                </then>
                                                <else>
                                                    <assign variable="identifikasi" expression="&quot;Keliling&quot;"/>
                                                    <output expression="&quot;Input Sisi Pertama&quot;" newline="True"/>
                                                    <input variable="a"/>
                                                    <output expression="&quot;Input Sisi Kedua&quot;" newline="True"/>
                                                    <input variable="b"/>
                                                    <assign variable="hasil" expression="2*(a+b)"/>
                                                </else>
                                            </if>
                                        </then>
                                        <else>
                                            <output expression="&quot;Nguawur nek nginput&quot;" newline="True"/>
                                            <assign variable="identifikasi" expression="&quot;Amal dan Ibadah&quot;"/>
                                            <assign variable="Pilihan3" expression="&quot;Diri sendiri&quot;"/>
                                            <assign variable="hasil" expression="0"/>
                                        </else>
                                    </if>
                                </else>
                            </if>
                        </else>
                    </if>
                </else>
            </if>
            <output expression="&quot;Program menghitung &quot;&amp;identifikasi &amp;&quot; &quot;&amp;Pilihan3 &amp;ToChar(13)&amp; &quot;Hasilnya adalah: &quot; &amp;hasil" newline="True"/>
        </body>
    </function>
</flowgorithm>
