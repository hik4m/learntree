<?xml version="1.0"?>
<flowgorithm fileversion="3.0">
    <attributes>
        <attribute name="name" value=""/>
        <attribute name="authors" value="Puskom"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2025-10-02 01:34:01 PM"/>
        <attribute name="created" value="UHVza29tO0cxLTEwOzIwMjUtMTAtMDI7MDE6Mjg6MjEgUE07MjE3MQ=="/>
        <attribute name="edited" value="UHVza29tO0cxLTEwOzIwMjUtMTAtMDI7MDE6MzQ6MDEgUE07MjsyMjc1"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="str, play, gel, bek, jml" type="Integer" array="False" size=""/>
            <output expression="&quot;Input Striker&quot;" newline="True"/>
            <input variable="str"/>
            <output expression="&quot;Input Playmaker&quot;" newline="True"/>
            <input variable="play"/>
            <output expression="&quot;Input Gelandang&quot;" newline="True"/>
            <input variable="gel"/>
            <output expression="&quot;Input Bek&quot;" newline="True"/>
            <input variable="bek"/>
            <assign variable="jml" expression="str+play+gel+bek"/>
            <if expression="jml=10">
                <then>
                    <output expression="&quot;Valid&quot; &amp;ToChar(13)&amp; &quot;Hasil formasinya: &quot; &amp;jml" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;Tidak Valid&quot; &amp;ToChar(13)&amp; &quot;Hasil formasinya: &quot; &amp;jml" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
